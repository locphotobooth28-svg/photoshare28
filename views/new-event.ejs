<!doctype html>
<html lang="fr">
<head>
  <%- include("partials-head") %>
  <title>Nouvel événement · PhotoShare 28</title>
</head>
<body>
  <main class="wrap" style="max-width:650px">
    <div class="topbar">
      <div class="brand">📸 PhotoShare 28</div>
      <a href="/admin">← Tableau de bord</a>
    </div>
    <section class="card">
      <h1>Créer un événement</h1>
      <% if (error) { %><div class="notice error"><%= error %></div><% } %>
      <form method="post" action="/admin/events">
        <label for="name">Nom de l'événement</label>
        <input id="name" name="name" placeholder="Lydie & Johan" required>
        <label for="date">Date</label>
        <input id="date" name="date" type="date" required>
        <label for="type">Type</label>
        <select id="type" name="type">
          <option>Mariage</option>
          <option>Anniversaire</option>
          <option>Baptême</option>
          <option>Entreprise</option>
          <option>Autre</option>
        </select>
        <button class="btn" type="submit" style="margin-top:18px">Créer la galerie</button>
      </form>
    </section>
  </main>
</body>
</html>
