<!doctype html>
<html lang="fr">
<head>
  <%- include("partials-head") %>
  <title>Espace organisateur · <%= event.name %></title>
</head>
<body>
<main class="wrap" style="max-width:1050px">

  <%- include("brand-bar") %>

  <section class="organizer-header">
    <div>
      <h1>Espace organisateur</h1>
      <p class="muted"><%= event.name %> · <%= event.date %></p>
    </div>
    <div class="expiry-chip">
      Galerie disponible jusqu'au
      <strong><%= new Date(event.expiresAt).toLocaleDateString("fr-FR") %></strong>
    </div>
  </section>

  <div class="grid">
    <div class="stat"><span class="muted">Souvenirs</span><strong><%= event.photos.length %></strong></div>
    <div class="stat"><span class="muted">Photos</span><strong><%= event.photos.filter(p => p.mimeType && p.mimeType.startsWith("image/")).length %></strong></div>
    <div class="stat"><span class="muted">Vidéos</span><strong><%= event.photos.filter(p => p.mimeType && p.mimeType.startsWith("video/")).length %></strong></div>
  </div>

  <section class="card" style="margin-top:18px">
    <h2>📋 Votre dossier</h2>

    <div class="status-grid">
      <div class="status-box <%= event.depositReceived ? 'status-ok' : 'status-wait' %>">
        <span>Chèque de caution</span>
        <strong><%= event.depositReceived ? "Reçu ✓" : "En attente" %></strong>
      </div>
      <div class="status-box <%= event.invoicePaid ? 'status-ok' : 'status-wait' %>">
        <span>Règlement facture</span>
        <strong><%= event.invoicePaid ? "Réglée ✓" : "En attente" %></strong>
      </div>
    </div>

    <h3>Matériel prévu</h3>
    <% if (!(event.inventory || []).length) { %>
      <p class="muted">L'inventaire n'a pas encore été renseigné.</p>
    <% } else { %>
      <ul class="inventory-list">
        <% event.inventory.forEach(item => { %>
          <li>✓ <%= item %></li>
        <% }) %>
      </ul>
    <% } %>

    <h3>Facture</h3>
    <% if (event.invoice) { %>
      <a class="btn secondary" href="/o/<%= event.code %>/<%= event.organizerToken %>/invoice">📄 Télécharger la facture PDF</a>
    <% } else { %>
      <p class="muted">La facture n'est pas encore disponible.</p>
    <% } %>
  </section>

  <section class="card share-card">
    <h2>📤 Partager avec vos invités</h2>
    <p class="muted">Vos invités pourront ajouter leurs photos et consulter la galerie pendant 30 jours.</p>

    <div class="organizer-share">
      <img class="qr organizer-qr" src="<%= qrDataUrl %>" alt="QR Code invités">
      <div class="share-details">
        <label>Lien invité</label>
        <div class="code"><%= guestUrl %></div>

        <div class="share-buttons">
          <button id="copyGuest" class="btn secondary" type="button">📋 Copier le lien</button>

          <a
            class="btn whatsapp-btn"
            target="_blank"
            rel="noopener"
            href="https://wa.me/?text=<%= encodeURIComponent('📸 Bonjour !\n\nPartagez vos photos et découvrez la galerie de notre événement ici :\n' + guestUrl + '\n\nLa galerie est disponible pendant 30 jours.\n\n📸 LOCATION PHOTOBOOTH 28\n🌐 www.locationphotobooth28.fr') %>">
            💬 Partager sur WhatsApp
          </a>

          <a
            class="btn secondary"
            href="/o/<%= event.code %>/<%= event.organizerToken %>/qr.png">
            📱 Télécharger le QR Code
          </a>
        </div>
      </div>
    </div>

    <div class="share-message">
      <strong>Message proposé :</strong>
      <p>
        📸 Bonjour !<br><br>
        Partagez vos photos et découvrez la galerie de notre événement grâce au lien ou au QR Code.<br>
        La galerie est disponible pendant 30 jours.<br><br>
        📸 LOCATION PHOTOBOOTH 28
      </p>
    </div>
  </section>

  <section class="card">
    <div class="topbar" style="margin-bottom:12px">
      <div>
        <h2 style="margin:0">📥 Vos souvenirs</h2>
        <p class="muted" style="margin:4px 0 0">Cliquez sur une photo pour l'ouvrir en plein écran.</p>
      </div>
      <% if (event.photos.length) { %>
        <a class="btn" href="/o/<%= event.code %>/<%= event.organizerToken %>/download-all">Télécharger tout (.ZIP)</a>
      <% } %>
    </div>

    <% if (!event.photos.length) { %>
      <p class="muted">Aucun souvenir n'a encore été ajouté.</p>
    <% } else { %>
      <div class="organizer-list">
      <% event.photos.forEach(photo => { %>
        <article class="organizer-file">
          <div class="organizer-preview">
            <% if (photo.mimeType && photo.mimeType.startsWith("image/")) { %>
              <button class="organizer-photo-open" type="button" aria-label="Ouvrir la photo en plein écran">
                <img loading="lazy" src="/e/<%= event.code %>/media/<%= photo.id %>" alt="Photo de la galerie">
              </button>
            <% } else { %>
              <div class="video-placeholder">🎥</div>
            <% } %>
          </div>
          <div class="organizer-file-info">
            <strong><%= photo.originalName %></strong>
            <span class="muted"><%= photo.source === "invite" ? "Invité" : photo.source %></span>
            <a class="btn secondary" href="/o/<%= event.code %>/<%= event.organizerToken %>/download/<%= photo.id %>">Télécharger</a>
          </div>
        </article>
      <% }) %>
      </div>
    <% } %>
  </section>

  <section class="company-card">
    <strong>LOCATION PHOTOBOOTH 28</strong>
    <p>Merci pour votre confiance ❤️</p>
    <div class="company-actions">
      <a class="btn secondary" href="https://www.locationphotobooth28.fr" target="_blank" rel="noopener">🌐 www.locationphotobooth28.fr</a>
      <a class="btn secondary" href="https://www.facebook.com/location.photobooth.28/" target="_blank" rel="noopener">
        <span class="facebook-icon small" aria-hidden="true">f</span> Facebook
      </a>
    </div>
  </section>

  <%- include("brand-footer") %>
</main>

<div id="lightbox" class="lightbox" hidden aria-hidden="true">
  <button id="lightboxClose" class="lightbox-close" type="button" aria-label="Fermer">×</button>
  <img id="lightboxImage" src="" alt="Photo en plein écran">
</div>

<script>
const copyButton = document.getElementById("copyGuest");
copyButton?.addEventListener("click", async () => {
  try {
    await navigator.clipboard.writeText("<%= guestUrl %>");
    const old = copyButton.textContent;
    copyButton.textContent = "Copié ✓";
    setTimeout(() => copyButton.textContent = old, 1600);
  } catch {
    alert("Copie impossible. Sélectionnez le lien manuellement.");
  }
});

const lightbox = document.getElementById("lightbox");
const lightboxImage = document.getElementById("lightboxImage");
const lightboxClose = document.getElementById("lightboxClose");

document.querySelectorAll(".organizer-photo-open img").forEach(img => {
  img.parentElement.addEventListener("click", () => {
    lightboxImage.src = img.src;
    lightbox.hidden = false;
    lightbox.setAttribute("aria-hidden", "false");
    document.body.classList.add("modal-open");
  });
});

function closeLightbox() {
  lightbox.hidden = true;
  lightbox.setAttribute("aria-hidden", "true");
  lightboxImage.src = "";
  document.body.classList.remove("modal-open");
}

lightboxClose.addEventListener("click", closeLightbox);
lightbox.addEventListener("click", event => {
  if (event.target === lightbox) closeLightbox();
});
document.addEventListener("keydown", event => {
  if (event.key === "Escape" && !lightbox.hidden) closeLightbox();
});
</script>
</body>
</html>
