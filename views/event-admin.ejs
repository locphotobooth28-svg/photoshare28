<!doctype html>
<html lang="fr">
<head><%- include("partials-head") %><title><%= event.name %> · PhotoShare 28</title></head>
<body>
<main class="wrap">
  <div class="topbar">
    <div><div class="brand">📸 PhotoShare 28</div><div class="muted"><%= event.name %></div></div>
    <a href="/admin">← Tableau de bord</a>
  </div>

  <% if (expired) { %><div class="notice error">⏳ Cette galerie a dépassé sa période de 30 jours.</div><% } %>

  <div class="grid">
    <div class="stat"><span class="muted">Souvenirs</span><strong><%= event.photos.length %></strong></div>
    <div class="stat"><span class="muted">Date</span><strong style="font-size:20px"><%= event.date %></strong></div>
    <div class="stat"><span class="muted">Expiration</span><strong style="font-size:18px"><%= new Date(event.expiresAt).toLocaleDateString("fr-FR") %></strong></div>
  </div>

  <section class="card" style="margin-top:18px">
    <h2>📱 Accès invités</h2>
    <p class="muted">Ajout de photos + consultation de la galerie. Aucun bouton de téléchargement.</p>
    <div class="organizer-share">
      <img class="qr" src="<%= qrDataUrl %>" alt="QR Code invités">
      <div>
        <div class="code"><%= guestUrl %></div>
        <button class="btn secondary copy-btn" type="button" data-copy="<%= guestUrl %>" style="margin-top:10px">Copier le lien invité</button>
      </div>
    </div>
  </section>

  <section class="card">
    <h2>👰 Accès organisateur</h2>
    <p class="muted">Lien privé à remettre uniquement au client organisateur.</p>
    <div class="code"><%= organizerUrl %></div>
    <button class="btn secondary copy-btn" type="button" data-copy="<%= organizerUrl %>" style="margin-top:10px">Copier le lien organisateur</button>
  </section>

  <section class="card">
    <h2>📷 API borne</h2>
    <div class="code">POST <%= guestUrl.replace('/e/', '/api/events/') %>/upload</div>
    <p><strong>En-tête :</strong></p>
    <div class="code">X-API-Key: <%= event.apiKey %></div>
  </section>
</main>
<script>
document.querySelectorAll(".copy-btn").forEach(btn => {
  btn.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.copy);
      const old = btn.textContent;
      btn.textContent = "Copié ✓";
      setTimeout(() => btn.textContent = old, 1500);
    } catch {}
  });
});
</script>
</body></html>
