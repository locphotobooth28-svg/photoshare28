<!doctype html>
<html lang="fr">
<head><%- include("partials-head") %><title><%= event.name %> · Galerie</title></head>
<body class="guest-page">
<main class="wrap" style="max-width:1000px">
  <section class="hero" style="padding-bottom:20px">
    <div class="brand">📸 PhotoShare 28</div>
    <h1><%= event.name %></h1>
    <p class="muted"><%= event.type %> · <%= event.date %></p>
    <p>Partagez vos plus beaux souvenirs ❤️</p>
  </section>

  <% if (uploaded) { %><div class="notice">✅ Merci ! Vos souvenirs ont bien été ajoutés.</div><% } %>
  <% if (error) { %><div class="notice error"><%= error %></div><% } %>

  <section class="card">
    <h2>📤 Ajouter mes photos</h2>
    <p class="muted">Jusqu'à 30 photos ou vidéos à la fois.</p>
    <form method="post" enctype="multipart/form-data" action="/e/<%= event.code %>/upload">
      <input name="photos" type="file" accept="image/*,video/*" multiple required>
      <button class="btn" type="submit" style="margin-top:14px">Envoyer mes souvenirs</button>
    </form>
  </section>

  <section class="card">
    <h2>🖼️ Galerie</h2>
    <% const images = event.photos.filter(p => p.mimeType && p.mimeType.startsWith("image/")); %>
    <% if (!images.length) { %>
      <p class="muted">Soyez les premiers à partager une photo !</p>
    <% } else { %>
      <div class="photo-grid guest-gallery">
        <% images.forEach(photo => { %>
          <figure class="photo-tile">
            <img loading="lazy" draggable="false" src="/e/<%= event.code %>/media/<%= photo.id %>" alt="Souvenir partagé">
          </figure>
        <% }) %>
      </div>
    <% } %>
    <p class="privacy-note">🔒 Aucun bouton de téléchargement n'est proposé dans l'accès invité.</p>
  </section>
</main>
<script>
document.addEventListener("contextmenu", e => {
  if (e.target && e.target.tagName === "IMG") e.preventDefault();
});
document.addEventListener("dragstart", e => {
  if (e.target && e.target.tagName === "IMG") e.preventDefault();
});
</script>
</body></html>
