<!doctype html>
<html lang="fr">
<head>
  <%- include("partials-head") %>
  <title>Connexion · PhotoShare 28</title>
</head>
<body>
  <main class="wrap" style="max-width:520px">
    <div class="topbar"><div class="brand">📸 PhotoShare 28</div></div>
    <section class="card">
      <h1>Administration</h1>
      <p class="muted">Connecte-toi pour gérer les événements.</p>
      <% if (error) { %><div class="notice error"><%= error %></div><% } %>
      <form method="post" action="/admin/login">
        <label for="email">Adresse e-mail</label>
        <input id="email" name="email" type="email" required autocomplete="username">
        <label for="password">Mot de passe</label>
        <input id="password" name="password" type="password" required autocomplete="current-password">
        <button class="btn" style="margin-top:18px;width:100%" type="submit">Se connecter</button>
      </form>
    </section>
  </main>
</body>
</html>
